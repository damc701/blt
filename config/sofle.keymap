#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "main";

            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE    &kp N1  &kp N2        &kp N3    &kp N4  &kp N5                                            &kp N6             &kp N7         &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB       &kp Q   &kp W         &kp E     &kp R   &kp T                                             &kp Y              &kp U          &kp I      &kp O    &kp P     &kp BSPC
&kp CAPSLOCK  &kp A   &kp S         &kp D     &kp F   &kp G                                             &kp H              &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT     &kp Z   &kp X         &kp C     &kp V   &kp B             &kp C_PLAY_PAUSE    &kp C_MUTE  &kp N              &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                      &kp LEFT_GUI  &kp LALT  &mo 1   &kp LEFT_CONTROL  &kp SPACE           &kp ENTER   &kp RIGHT_CONTROL  &kp RIGHT_GUI  &kp RALT   &mo 2
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp K_NEXT K_PREV>;
        };

        lower_layer {
            display-name = "f#";

            // ------------------------------------------------------------------------------------------------------------
            // | `     |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | RAISE |   1 |   2 |   3  |   4  |   5  |                   |   6  |   7   |   8   |   9  |    0  |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1     &kp F2          &kp F3          &kp F4          &kp F5           &kp F6                    &kp F7  &kp F8  &kp F9  &kp F10           &kp F11            &kp F12
&kp MINUS  &kp UNDERSCORE  &trans          &kp UP_ARROW    &trans           &trans                    &trans  &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&kp EQUAL  &trans          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans                    &trans  &trans  &trans  &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans
&trans     &trans          &trans          &kp C_PREV      &kp C_NEXT       &trans  &trans    &trans  &trans  &trans  &trans  &trans            &kp PIPE           &kp QUESTION
                           &trans          &trans          &trans           &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        raise_layer {
            display-name = "bt";

            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |     | INS  | PSCR | GUI   |       |      |                | PGUP |      |       |      |       |       |
            // |     | ALT  | CTRL | SHIFT |       | CAPS |                |  <-  |   v  |   ^   |  ->  |  DEL  | BKSPC |
            // |     | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //              |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans           &trans           &trans           &kp INSERT     &kp DELETE
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp HOME       &kp END
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS      &kp PLUS
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp BACKSLASH  &kp PRINTSCREEN
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans  &kp KP_NUMBER_0  &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
